# ─── Auth ────────────────────────────────────────────────────────────────────
# Per request the spawned Claude uses the FIRST credential available, in this order:
#   1. the caller's own key sent in a request header (BYOK section below)
#   2. a server ANTHROPIC_API_KEY set here
#   3. the Claude subscription token (CLAUDE_TOKEN) set here
# Set whichever server fallback you want — either or both; if both are set the API key
# wins over the subscription. A per-request header key still overrides both (and bills
# to the caller).

# Claude subscription (Max/Pro). Generate with `claude setup-token`; the server maps it
# to CLAUDE_CODE_OAUTH_TOKEN (the var the CLI reads).
CLAUDE_TOKEN=sk-ant-oat01-***************--fh9VQAA

# Anthropic API key. If set, it takes precedence over CLAUDE_TOKEN above.
#ANTHROPIC_API_KEY=sk-ant-api03-***************

# ─── Per-request BYOK (bring-your-own-key) ───────────────────────────────────
# A caller sends their own Anthropic key in a request header; the server reads it
# fresh per request and injects it into the spawned CLI (never stored). Works on
# Claude Code, which attaches configured headers on every request:
#   claude mcp add --transport http --scope user likeminds <url> \
#       --header "x-api-key: sk-ant-api03-YOURKEY"

# Header the key is read from (default x-api-key; also accepts Authorization: Bearer).
#LIKEMINDS_MCP_KEY_HEADER=x-api-key

# ─── Optional overrides ──────────────────────────────────────────────────────

# Model for spawned turns. Default is opus[1m] (latest Opus, 1M-token context).
# If an API key lacks 1M-context Opus access, use a model it can serve, e.g. sonnet.
#CLAUDE_AGENT_MODEL=opus[1m]

# Path to the claude CLI (default: resolved from PATH).
#CLAUDE_BIN=/usr/local/bin/claude
