# ─── Auth ────────────────────────────────────────────────────────────────────
# Per request the spawned Claude uses the FIRST credential available, in this order:
#   1. the caller's own key sent in a request header (BYOK section below)
#   2. a server ANTHROPIC_API_KEY set here
#   3. the Claude subscription token (CLAUDE_TOKEN) set here
# Set whichever server fallback you want — either or both; if both are set the API key
# wins over the subscription. A per-request header key still overrides both (and bills
# to the caller).

# Claude subscription (Max/Pro). Generate with `claude setup-token`; the server maps it
# to CLAUDE_CODE_OAUTH_TOKEN (the var the CLI reads).
CLAUDE_TOKEN=sk-ant-oat01-***************--fh9VQAA

# Anthropic API key. If set, it takes precedence over CLAUDE_TOKEN above.
#ANTHROPIC_API_KEY=sk-ant-api03-***************

# ─── Per-request BYOK (bring-your-own-key) ───────────────────────────────────
# A caller sends their own Anthropic key in a request header; the server reads it
# fresh per request and injects it into the spawned CLI (never stored). Works on
# Claude Code, which attaches configured headers on every request:
#   claude mcp add --transport http --scope user likeminds <url> \
#       --header "x-api-key: sk-ant-api03-YOURKEY"

# Header the key is read from (default x-api-key; also accepts Authorization: Bearer).
#LIKEMINDS_MCP_KEY_HEADER=x-api-key

# ─── Optional overrides ──────────────────────────────────────────────────────

# Model for spawned turns. Default is opus[1m] (latest Opus, 1M-token context).
# If an API key lacks 1M-context Opus access, use a model it can serve, e.g. sonnet.
#CLAUDE_AGENT_MODEL=opus[1m]

# Path to the claude CLI (default: resolved from PATH).
#CLAUDE_BIN=/usr/local/bin/claude

# ─── Multi-tenant login (email OTP) ──────────────────────────────────────────
# A user signs in at /login with their email, gets a one-time code, and receives a
# STABLE token (their Mongo user id). Their MCP client sends it on every request in
# this header, so custom skills a user creates stay private to that user. Distinct
# from the BYOK key header above (that one selects who PAYS; this one is WHO you are).
#
# Without MONGODB_URI the server runs WITHOUT login: there's no /login page and any
# token header is trusted opaquely as a tenant key (fine for local dev). Set Mongo +
# EMAIL_GHUPSHAP_KEY in production to require verified login.

# Header the login token is read from (default x-user-id).
#LIKEMINDS_MCP_USER_HEADER=x-user-id

# MongoDB — the user/tenant registry (mirrors agentic-core-backend's user model).
#MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
#MONGODB_DB_NAME=likeminds
#MONGODB_USERS_COLLECTION=users
# TLS-only managed Mongo (e.g. AWS DocumentDB): set both to connect over TLS with a CA.
#CLOUD_PROVIDER=AWS
#CA_FILE_PATH=/etc/ssl/rds-combined-ca-bundle.pem

# Gupshup TwoFactorAuth key — the hosted service that emails + verifies the OTP.
#EMAIL_GHUPSHAP_KEY=your-gupshup-2fa-key

# Public origin shown in the /login copy-paste config (set behind a proxy so the
# snippet shows your real host, not the internal bind address).
#PUBLIC_BASE_URL=https://mcp.likeminds.io

# Seconds to cache a token→verified lookup (so frequent polls don't hit Mongo).
#LIKEMINDS_MCP_TENANT_CACHE_TTL=300

# ─── OAuth 2.1 (recommended: client-driven login, no hand-pasted token) ───────
# When true, the server becomes an OAuth 2.1 authorization server: Claude runs the
# browser login itself (the Gupshup OTP page is the /authorize UI) and manages the
# access token. Requires MONGODB_URI + a REAL, reachable PUBLIC_BASE_URL (the issuer —
# https:// in prod, http://localhost:8787 for local; never 0.0.0.0). While OFF, the
# header-based x-user-id path is used. x-api-key (BYOK billing) works either way.
#MCP_OAUTH_ENABLED=false
#MCP_OAUTH_ACCESS_TTL=3600
#MCP_OAUTH_REFRESH_TTL=2592000
#MCP_OAUTH_CODE_TTL=600
#MCP_OAUTH_SCOPE=mcp

# ─── Global skill kill-switch ────────────────────────────────────────────────
# Hide skills from EVERYONE (both list_skills and run_skill). Edit disabled_skills.json
# ({"disabled": ["skill-name"]}) at the project root — read fresh per call, no restart.
# This env var is an optional comma-separated override, merged with that file.
#LIKEMINDS_MCP_DISABLED_SKILLS=skill-a,skill-b
#LIKEMINDS_MCP_DISABLED_SKILLS_FILE=disabled_skills.json
