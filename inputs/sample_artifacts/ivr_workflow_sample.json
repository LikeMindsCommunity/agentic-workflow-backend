{
  "workflow": {
    "id": "wf_ivr_001",
    "name": "Customer Support IVR",
    "version": 2,
    "status": "active",
    "language": "en",
    "entryPoint": "node_welcome",
    "nodes": [
      {
        "id": "node_welcome",
        "type": "playback",
        "label": "Welcome Message",
        "config": {
          "audioFile": "audio_welcome_en.wav",
          "interruptible": false
        },
        "next": "node_language"
      },
      {
        "id": "node_language",
        "type": "menu",
        "label": "Language Selection",
        "config": {
          "prompt": "audio_lang_select.wav",
          "timeout": 5,
          "retryCount": 3,
          "options": [
            { "digit": "1", "label": "English", "next": "node_main_menu" },
            { "digit": "2", "label": "Hindi", "next": "node_main_menu_hi" }
          ],
          "fallbackAction": {
            "type": "transfer",
            "target": "queue_default"
          }
        },
        "next": null
      },
      {
        "id": "node_main_menu",
        "type": "menu",
        "label": "Main Menu",
        "config": {
          "prompt": "audio_main_menu_en.wav",
          "timeout": 10,
          "retryCount": 2,
          "options": [
            { "digit": "1", "label": "Sales", "next": "node_transfer_sales" },
            { "digit": "2", "label": "Support", "next": "node_transfer_support" },
            { "digit": "3", "label": "Billing", "next": "node_transfer_billing" },
            { "digit": "0", "label": "Operator", "next": "node_transfer_operator" }
          ],
          "fallbackAction": {
            "type": "playback",
            "audioFile": "audio_invalid_input.wav",
            "next": "node_main_menu"
          }
        },
        "next": null
      },
      {
        "id": "node_transfer_sales",
        "type": "transfer",
        "label": "Transfer to Sales",
        "config": {
          "target": "queue_sales",
          "priority": 1,
          "routingStrategy": 3,
          "waitMusic": "audio_hold_music.wav",
          "maxWaitTime": 120,
          "onTimeout": {
            "type": "voicemail",
            "greeting": "audio_vm_sales.wav"
          }
        },
        "next": null
      },
      {
        "id": "node_transfer_support",
        "type": "transfer",
        "label": "Transfer to Support",
        "config": {
          "target": "queue_support",
          "priority": 2,
          "routingStrategy": 1,
          "waitMusic": "audio_hold_music.wav",
          "maxWaitTime": 180,
          "skillTags": ["technical", "product"],
          "onTimeout": {
            "type": "callback",
            "message": "audio_callback_offer.wav"
          }
        },
        "next": null
      },
      {
        "id": "node_transfer_billing",
        "type": "transfer",
        "label": "Transfer to Billing",
        "config": {
          "target": "queue_billing",
          "priority": 1,
          "routingStrategy": 2,
          "waitMusic": "audio_hold_music.wav",
          "maxWaitTime": 90,
          "requireAuth": true,
          "authMethod": "caller_id"
        },
        "next": null
      },
      {
        "id": "node_transfer_operator",
        "type": "transfer",
        "label": "Transfer to Operator",
        "config": {
          "target": "queue_default",
          "priority": 3,
          "routingStrategy": 1,
          "waitMusic": "audio_hold_music.wav",
          "maxWaitTime": 60
        },
        "next": null
      }
    ],
    "metadata": {
      "createdBy": "admin@company.com",
      "createdAt": "2024-11-15T10:30:00Z",
      "updatedAt": "2025-01-20T14:22:00Z",
      "tags": ["production", "customer-support"],
      "region": "IN"
    }
  }
}
